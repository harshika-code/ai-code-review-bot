# Template for the real .env file.
# Copy this file to ".env" and fill in your own values — .env is
# git-ignored and must NEVER be committed or shared.

# ---------------------------------------------------------------------------
# A GitHub personal access token with access to the target repository.
# Fine-grained token: enable "Contents: Read-only" and "Pull requests: Read
# and write". Classic token: select the "repo" scope.
# ---------------------------------------------------------------------------
GITHUB_TOKEN=ghp_replace_me_with_your_real_token

# ---------------------------------------------------------------------------
# Any long random string of your choice. The exact same value must be typed
# into the "Secret" box of the GitHub webhook settings page.
# Example generator (in a terminal): python -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------------
GITHUB_WEBHOOK_SECRET=replace_me_with_a_long_random_string

# Optional. Default INFO. Use DEBUG to see every webhook payload detail.
LOG_LEVEL=INFO

# Optional. "true" makes the bot request changes (which blocks merging)
# when it finds security issues. Default: off (bot only comments).
REVIEW_STRICT=false
